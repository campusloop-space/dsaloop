{
  "name": "algoforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "fetch": "tsx scripts/fetch-repo.ts",
    "parse": "tsx scripts/parse-index.ts",
    "generate": "tsx scripts/pipeline.ts",
    "search": "tsx scripts/pipeline.ts",
    "sitemap": "tsx scripts/pipeline.ts",
    "rss": "tsx scripts/pipeline.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "validate:data": "tsx scripts/validate-generated.ts",
    "test": "tsx tests/compiler-judge.test.ts",
    "build:server": "esbuild src/lib/api/code-handlers.ts --bundle --platform=node --format=esm --external:esbuild --outfile=src/server/code-handlers.mjs",
    "check": "npm run lint && npm run typecheck && npm run validate:data",
    "build": "next build && npm run build:server",
    "start": "next start",
    "lint": "eslint",
    "pipeline": "npm run fetch && npm run generate"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
