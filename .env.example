# ==============================================================================
# DSALoop Environment Configuration
# DSALoop by https://campusloop.space/
# ==============================================================================

# Server configuration
PORT=3002
NODE_ENV=production
SITE_URL=https://dsaloop.campusloop.space
CAMPUSLOOP_URL=https://campusloop.space/

# Execution Provider ("auto", "judge0", or "wandbox")
# - "auto": Uses Judge0 if credentials/URL provided, falls back to Wandbox
# - "judge0": Strict Judge0 execution
# - "wandbox": Public zero-auth execution engine
EXECUTION_PROVIDER=auto

# Judge0 Configuration (Managed CE, RapidAPI, or Self-Hosted)
# Official documentation: https://ce.judge0.com/
# Self-hosted default: http://localhost:2358
JUDGE0_API_URL=https://ce.judge0.com

# Judge0 API Key / Token (leave empty for unauthenticated or public self-hosted instances)
# For RapidAPI: provide your X-RapidAPI-Key
# For Self-hosted with auth: provide your X-Auth-Token
JUDGE0_API_KEY=

# Rate Limiting & Safety Controls
# Maximum code execution requests per minute per IP
RATE_LIMIT_PER_MINUTE=30

# Maximum source code size in bytes (default: 65536 = 64KB)
MAX_SOURCE_SIZE_BYTES=65536

# Maximum stdin size in bytes (default: 32768 = 32KB)
MAX_STDIN_SIZE_BYTES=32768
